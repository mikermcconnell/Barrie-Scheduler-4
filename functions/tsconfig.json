{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@google/generative-ai": ["./node_modules/@google/generative-ai"],
      "xlsx": ["./node_modules/xlsx"]
    }
  },
  "compileOnSave": true,
  "include": ["src"]
}
