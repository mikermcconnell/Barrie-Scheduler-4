{
  "name": "scheduler-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for Scheduler 4 - auto-ingest STREETS performance data",
  "main": "lib/functions/src/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "admin:scheduler": "node scripts/set-scheduler-admin.mjs",
    "backfill:dashboard-views": "npm run build && node scripts/backfill-performance-dashboard-views.mjs",
    "bootstrap:ridership-trends": "npm run build && node scripts/bootstrap-ridership-trends.mjs",
    "backfill:simulator-days": "npm run build && node scripts/backfill-simulator-days.mjs"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "fflate": "^0.8.2",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.3.2",
    "jspdf": "^4.2.1",
    "sharp": "^0.35.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "private": true
}
