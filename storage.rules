rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isTeamMember(teamId) {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    function hasUserTeam() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.teamId is string;
    }

    function userTeamId() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.teamId;
    }

    function isTeamManager(teamId) {
      return request.auth != null &&
        (
          firestore.get(/databases/(default)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'owner' ||
          firestore.get(/databases/(default)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'admin'
        );
    }

    function isSchedulerAdmin() {
      return request.auth != null &&
        request.auth.token.get('schedulerAdmin', false) == true;
    }

    function supportSession() {
      return firestore.get(/databases/(default)/documents/developerSupportSessions/$(request.auth.uid));
    }

    function hasActiveSupportSession(teamId) {
      return isSchedulerAdmin() &&
        firestore.exists(/databases/(default)/documents/developerSupportSessions/$(request.auth.uid)) &&
        supportSession().data.teamId == teamId &&
        supportSession().data.expiresAt is timestamp &&
        supportSession().data.expiresAt > request.time &&
        supportSession().data.mode in ['inspect', 'edit'];
    }

    function canSupportReadTeamData(teamId) {
      return hasActiveSupportSession(teamId);
    }

    function canSupportWriteTeamData(teamId) {
      return hasActiveSupportSession(teamId) && supportSession().data.mode == 'edit';
    }

    function memberAccessLevel(teamId) {
      let member = firestore.get(/databases/(default)/documents/teams/$(teamId)/members/$(request.auth.uid));
      let accessLevel = member.data.get('accessLevel', null);
      return accessLevel == 'none' ||
             accessLevel == 'production' ||
             accessLevel == 'planner' ||
             accessLevel == 'external-planner' ||
             accessLevel == 'transit-app-only' ||
             accessLevel == 'parking' ||
             accessLevel == 'admin' ||
             accessLevel == 'internal'
             ? accessLevel
             : ((member.data.get('role', 'member') == 'owner' ||
                 member.data.get('role', 'member') == 'admin')
                ? 'internal'
                : 'planner');
    }

    function memberWorkspaceOverride(teamId, feature) {
      return firestore.get(/databases/(default)/documents/teams/$(teamId)/members/$(request.auth.uid))
        .data
        .get('workspaceOverrides', {})
        .get(feature, null);
    }

    function workspaceAllowedByProfile(accessLevel, feature) {
      return accessLevel == 'internal' ||
             (accessLevel == 'admin' &&
              (feature in ['workspaceFixedRoute', 'workspaceOperations', 'workspaceParking', 'analyticsTransitApp', 'analyticsFarePrograms', 'analyticsStrategicPlan', 'analyticsRidershipTrend'])) ||
             (accessLevel == 'planner' &&
              (feature in ['workspaceFixedRoute', 'workspaceOperations', 'analyticsTransitApp', 'analyticsFarePrograms', 'analyticsStrategicPlan', 'analyticsRidershipTrend'])) ||
             (accessLevel == 'production' &&
              (feature in ['workspaceFixedRoute', 'workspaceOperations'])) ||
             (accessLevel == 'external-planner' && feature == 'analyticsTransitApp') ||
             (accessLevel == 'transit-app-only' && feature == 'analyticsTransitApp') ||
             (accessLevel == 'parking' && feature == 'workspaceParking');
    }

    function canAccessWorkspace(teamId, feature) {
      return isTeamMember(teamId) &&
              (isSchedulerAdmin() ||
               memberWorkspaceOverride(teamId, feature) == true ||
               (memberWorkspaceOverride(teamId, feature) != false &&
                workspaceAllowedByProfile(memberAccessLevel(teamId), feature)));
    }

    function teamDataSources(teamId) {
      return firestore.get(/databases/(default)/documents/teams/$(teamId)).data.get('dataSourceTeamIds', {});
    }

    function configuredMasterScheduleSource(teamId) {
      return teamDataSources(teamId).get(
        'masterSchedules',
        teamDataSources(teamId).get('performance', '')
      );
    }

    function canReadSharedMasterSchedules(sourceTeamId) {
      return hasUserTeam() &&
        userTeamId() != sourceTeamId &&
        isTeamMember(userTeamId()) &&
        (canAccessWorkspace(userTeamId(), 'workspaceFixedRoute') ||
         canAccessWorkspace(userTeamId(), 'analyticsStrategicPlan')) &&
        configuredMasterScheduleSource(userTeamId()) == sourceTeamId;
    }

    // User-uploaded files can be read by scheduler admins for developer support.
    // Writes stay limited to the owner.
    match /users/{userId}/files/{allPaths=**} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isSchedulerAdmin());
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        allPaths.matches('.*\\.[cC][sS][vV]$|.*\\.[xX][lL][sS][xX]?$') &&
        request.resource.size > 0 &&
        request.resource.size <= 25 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Other user-owned Storage prefixes remain private to their owner. Keep
    // these explicit so File Manager uploads cannot bypass their size rule.
    match /users/{userId}/drafts/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/draftSchedules/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/systemDrafts/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/newScheduleProjects/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Team master schedules - restricted to members of the team
    match /teams/{teamId}/masterSchedules/{allPaths=**} {
      allow read: if canAccessWorkspace(teamId, 'workspaceFixedRoute') ||
        canAccessWorkspace(teamId, 'analyticsStrategicPlan') ||
        canReadSharedMasterSchedules(teamId) ||
        canSupportReadTeamData(teamId);
      allow write: if isTeamManager(teamId) || canSupportWriteTeamData(teamId);
    }

    // Immutable schedule-review payloads. A creator may delete only an orphaned
    // upload when the matching Firestore metadata write did not complete.
    match /teams/{teamId}/scheduleReviews/{reviewId}/{creatorId}/schedule.json {
      allow read: if canAccessWorkspace(teamId, 'workspaceFixedRoute') ||
        canSupportReadTeamData(teamId);
      allow create: if request.auth != null &&
        request.auth.uid == creatorId &&
        (canAccessWorkspace(teamId, 'workspaceFixedRoute') || canSupportWriteTeamData(teamId)) &&
        request.resource.contentType == 'application/json' &&
        request.resource.size > 0 &&
        request.resource.size <= 10 * 1024 * 1024;
      allow update: if false;
      allow delete: if canSupportWriteTeamData(teamId) ||
        (request.auth != null &&
         request.auth.uid == creatorId &&
         !firestore.exists(/databases/(default)/documents/teams/$(teamId)/scheduleReviews/$(reviewId)));
    }

    // Team route map images
    match /teams/{teamId}/routeMaps/{allPaths=**} {
      allow read: if isTeamMember(teamId) || canSupportReadTeamData(teamId);
      allow write: if isTeamManager(teamId) || canSupportWriteTeamData(teamId);
    }

    // Team transit app data (aggregated JSON)
    match /teams/{teamId}/transitAppData/{allPaths=**} {
      allow read: if canAccessWorkspace(teamId, 'analyticsTransitApp') ||
        canAccessWorkspace(teamId, 'analyticsStrategicPlan') ||
        canSupportReadTeamData(teamId);
      allow write: if canAccessWorkspace(teamId, 'analyticsTransitApp') || canSupportWriteTeamData(teamId);
    }

    // Team performance data (STREETS summaries)
    match /teams/{teamId}/performanceData/{allPaths=**} {
      allow read: if canAccessWorkspace(teamId, 'workspaceOperations') || canSupportReadTeamData(teamId);
      allow write: if isTeamManager(teamId) || canSupportWriteTeamData(teamId);
    }

    // Compact Load Profiles read models. Normal reads go through the backend,
    // which enforces operationsLoadProfiles and shared-source authorization.
    // Team members may still publish these views through the existing manual
    // import flow until all performance publishing moves server-side.
    match /teams/{teamId}/performanceViews/load-profiles/{allPaths=**} {
      allow read: if canSupportReadTeamData(teamId);
      allow write: if isTeamManager(teamId) || canSupportWriteTeamData(teamId);
    }

    // Team Transit On Demand pickup map data
    match /teams/{teamId}/todPickupData/{allPaths=**} {
      allow read: if isTeamMember(teamId) || canSupportReadTeamData(teamId);
      allow write: if isTeamManager(teamId) || canSupportWriteTeamData(teamId);
    }

    // Team shared parking-code usage data
    match /teams/{teamId}/parking/{allPaths=**} {
      allow read: if canAccessWorkspace(teamId, 'workspaceParking') || canSupportReadTeamData(teamId);
      allow write: if canAccessWorkspace(teamId, 'workspaceParking') || canSupportWriteTeamData(teamId);
    }

    // Team OD matrix data (origin-destination summaries)
    match /teams/{teamId}/odMatrixData/{allPaths=**} {
      allow read: if isTeamMember(teamId) || canSupportReadTeamData(teamId);
      allow write: if isTeamMember(teamId) || canSupportWriteTeamData(teamId);
    }

    // Team Fleet Plan data
    match /teams/{teamId}/fleetPlan/{allPaths=**} {
      allow read: if canAccessWorkspace(teamId, 'analyticsFleetPlan') ||
                     canAccessWorkspace(teamId, 'analyticsStrategicPlan') ||
                     canSupportReadTeamData(teamId);
      allow write: if isTeamManager(teamId) || canSupportWriteTeamData(teamId);
    }

    // Compact long-term fixed-route ridership projection. Unlike the broader
    // Operations archives, this view has its own Planning Data permission.
    match /teams/{teamId}/performanceViews/ridership-trends/{generation} {
      allow read: if generation.matches('^[0-9]+[.]json$') &&
        (canAccessWorkspace(teamId, 'analyticsRidershipTrend') ||
         canSupportReadTeamData(teamId));
      allow write: if generation.matches('^[0-9]+[.]json$') &&
        (isTeamManager(teamId) || canSupportWriteTeamData(teamId));
    }

    // Team Residential Growth planning data
    match /teams/{teamId}/residentialGrowth/{allPaths=**} {
      allow read: if isTeamMember(teamId) || canSupportReadTeamData(teamId);
      allow write: if isTeamMember(teamId) || canSupportWriteTeamData(teamId);
    }

    // Apply support-session access consistently to current and future team
    // storage paths without creating a permanent global-admin bypass.
    match /teams/{teamId}/{allPaths=**} {
      allow read: if canSupportReadTeamData(teamId);
      allow write: if canSupportWriteTeamData(teamId);
    }
  }
}
