{
  "name": "transit-scheduler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "test": "vitest",
    "test:firestore-rules": "npx --yes firebase-tools@15.24.0 emulators:exec --only firestore,storage --project demo-scheduler-4 \"vitest run --no-file-parallelism tests/routeConceptPlannerFirestoreRules.emulator.test.ts tests/detourFirestoreRules.emulator.test.ts tests/transitAppEvidenceRules.emulator.test.ts tests/todZoneFirestoreRules.emulator.test.ts tests/strategicWorkplanFirestoreRules.emulator.test.ts\"",
    "test:route-concept-browser": "node scripts/routeConceptPlannerBrowserSmoke.mjs",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "npm run build && node scripts/browserSmoke.mjs",
    "demo:ondemand": "npm run build && node scripts/onDemandDemoCapture.mjs",
    "build": "vite build",
    "build:prod": "node scripts/build-production.mjs",
    "docs:check": "node scripts/checkDocumentationContext.mjs",
    "fare-programs:generate": "node scripts/generateFareProgramsSnapshot.mjs --write",
    "fare-programs:check": "node scripts/generateFareProgramsSnapshot.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepare": "husky",
    "gtfs:index": "npx tsx scripts/buildGtfsTripIndex.ts",
    "backfill:missed-trips": "node functions/scripts/backfill-missed-trips.mjs",
    "backfill-missed-trips": "node functions/scripts/backfill-missed-trips.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@google/generative-ai": "^0.24.1",
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@tanstack/react-query": "^5.90.21",
    "adm-zip": "^0.5.16",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "firebase": "^12.6.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.555.0",
    "mapbox-gl": "^3.19.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-dropzone": "^14.3.8",
    "react-map-gl": "^8.1.0",
    "recharts": "^3.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.1.0",
    "@eslint/js": "^9.39.2",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/adm-zip": "^0.5.7",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.5.15",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.3",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.4",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "playwright": "^1.58.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vite": "^7.2.6",
    "vitest": "^4.1.3"
  }
}
