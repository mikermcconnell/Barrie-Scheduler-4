rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========== USERS ==========

    // Users can access their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can access their own subdocuments (projects, drafts, etc.)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ========== TEAMS ==========

    // Team documents are readable by team members.
    // Global workspace permission managers can also look up teams
    // by code for user permission management.
    // Team creation remains authenticated; updates/deletes are available to
    // team owners/admins and workspace permission managers.
    match /teams/{teamId} {
      allow get: if isTeamMember(teamId) || isWorkspacePermissionManager() || canReadTeamForInviteJoin(teamId);
      allow list: if isWorkspacePermissionManager();
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
                              (isTeamOwnerOrAdmin(teamId) || isWorkspacePermissionManager());

      // Team Members
      match /members/{memberId} {
        // Allow users to read their own membership doc (needed for invite join flow)
        // and full member list only when already in the team.
        allow read: if request.auth != null &&
                       (request.auth.uid == memberId || isTeamMember(teamId) || isWorkspacePermissionManager());
        // Allow member creation through a valid invite, initial owner creation
        // for a new team, or owner/admin management.
        allow create: if request.auth != null &&
                         (canCreateSelfFromInvite(teamId, memberId) ||
                          canCreateInitialOwner(teamId, memberId) ||
                          isTeamOwnerOrAdmin(teamId) ||
                          isWorkspacePermissionManager());
        allow update: if isTeamOwnerOrAdmin(teamId) ||
                         (isWorkspacePermissionManager() &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accessLevel', 'workspaceOverrides']));
        allow delete: if isTeamOwnerOrAdmin(teamId) || isWorkspacePermissionManager();
      }

      // Master Schedules
      match /masterSchedules/{scheduleId} {
        allow read: if canAccessWorkspace(teamId, 'workspaceFixedRoute');
        allow create, update, delete: if isTeamOwnerOrAdmin(teamId) || isWorkspacePermissionManager();

        // Version History
        match /versions/{versionId} {
          allow read: if canAccessWorkspace(teamId, 'workspaceFixedRoute');
          allow create, update, delete: if isTeamOwnerOrAdmin(teamId) || isWorkspacePermissionManager();
        }
      }

      // Platform configuration
      match /platformConfig/{configId} {
        allow read: if isTeamMember(teamId);
        allow create, update, delete: if isTeamOwnerOrAdmin(teamId) || isWorkspacePermissionManager();
      }

      // Shared connection library
      match /connectionLibrary/{libraryId} {
        allow read, write: if isTeamMember(teamId);
      }

      // Public timetable brochure settings
      match /publicTimetable/{docId} {
        allow read: if isTeamMember(teamId);
        allow create, update, delete: if isTeamOwnerOrAdmin(teamId) || isWorkspacePermissionManager();
      }

      // Per-route connection configuration
      match /routeConnectionConfigs/{routeIdentity} {
        allow read, write: if isTeamMember(teamId);
      }

      // Transit App Data
      match /transitAppData/{docId} {
        allow read, write: if canAccessWorkspace(teamId, 'analyticsTransitApp');
      }

      // Performance Data
      match /performanceData/{docId} {
        allow read, write: if isTeamMember(teamId);
      }

      // Transit On Demand pickup map data
      match /todPickupData/{docId} {
        allow read: if isTeamMember(teamId);
        allow create, update, delete: if isTeamOwnerOrAdmin(teamId) || isWorkspacePermissionManager();
      }

      // Monthly performance snapshots
      match /performanceSnapshots/{docId} {
        allow read, write: if isTeamMember(teamId);
      }

      // OD Matrix Data
      match /odMatrixData/{docId} {
        allow read, write: if canAccessWorkspace(teamId, 'analyticsOdMatrix');

        // Import history subcollection
        match /imports/{importId} {
          allow read, write: if canAccessWorkspace(teamId, 'analyticsOdMatrix');
        }
      }

      // Fleet Plan data
      match /fleetPlan/{docId} {
        allow read: if canAccessWorkspace(teamId, 'analyticsFleetPlan');
        allow create, update, delete: if isTeamOwnerOrAdmin(teamId) || isWorkspacePermissionManager();

        // Fleet Plan version history
        match /versions/{versionId} {
          allow read: if canAccessWorkspace(teamId, 'analyticsFleetPlan');
          allow create, update, delete: if isTeamOwnerOrAdmin(teamId) || isWorkspacePermissionManager();
        }
      }

      // Residential Growth planning data
      match /residentialGrowth/{docId} {
        allow read, write: if canAccessWorkspace(teamId, 'analyticsResidentialGrowth');

        // Import history subcollection
        match /imports/{importId} {
          allow read, write: if canAccessWorkspace(teamId, 'analyticsResidentialGrowth');
        }
      }

      // Route Planner 2 saved route concepts
      match /routePlanner2Projects/{projectId} {
        allow read, write: if canAccessWorkspace(teamId, 'analyticsRoutePlanner2');

        // Editable scenarios saved under each route planner project
        match /scenarios/{scenarioId} {
          allow read, write: if canAccessWorkspace(teamId, 'analyticsRoutePlanner2');
        }
      }
    }

    // Invite lookup documents support the authenticated join flow.
    match /teamInvites/{inviteCode} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
                              request.resource.data.teamId is string &&
                              (isTeamOwnerOrAdmin(request.resource.data.teamId) ||
                               isWorkspacePermissionManager() ||
                               canCreateInviteForNewTeam(request.resource.data.teamId));
      allow delete: if request.auth != null &&
                       resource.data.teamId is string &&
                       (isTeamOwnerOrAdmin(resource.data.teamId) || isWorkspacePermissionManager());
    }

    // ========== HELPER FUNCTIONS ==========

    function isTeamMember(teamId) {
      return request.auth != null &&
             exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    function canReadTeamForInviteJoin(teamId) {
      let inviteCode = resource.data.inviteCode;
      return request.auth != null &&
             inviteCode is string &&
             exists(/databases/$(database)/documents/teamInvites/$(inviteCode)) &&
             get(/databases/$(database)/documents/teamInvites/$(inviteCode)).data.teamId == teamId;
    }

    function canCreateSelfFromInvite(teamId, memberId) {
      let inviteCode = request.resource.data.inviteCode;
      return request.auth.uid == memberId &&
             request.resource.data.role == 'member' &&
             inviteCode is string &&
             exists(/databases/$(database)/documents/teamInvites/$(inviteCode)) &&
             get(/databases/$(database)/documents/teamInvites/$(inviteCode)).data.teamId == teamId;
    }

    function canCreateInitialOwner(teamId, memberId) {
      return request.auth.uid == memberId &&
             request.resource.data.role == 'owner' &&
             !exists(/databases/$(database)/documents/teams/$(teamId)) &&
             getAfter(/databases/$(database)/documents/teams/$(teamId)).data.createdBy == request.auth.uid;
    }

    function canCreateInviteForNewTeam(teamId) {
      return !exists(/databases/$(database)/documents/teams/$(teamId)) &&
             getAfter(/databases/$(database)/documents/teams/$(teamId)).data.createdBy == request.auth.uid &&
             getAfter(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'owner';
    }

    function isTeamOwnerOrAdmin(teamId) {
      let member = get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
      return request.auth != null &&
             (member.data.role == 'owner' || member.data.role == 'admin');
    }

    function memberAccessLevel(teamId) {
      let member = get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
      let accessLevel = member.data.get('accessLevel', null);
      return accessLevel == 'none' ||
             accessLevel == 'production' ||
             accessLevel == 'planner' ||
             accessLevel == 'external-planner' ||
             accessLevel == 'transit-app-only' ||
             accessLevel == 'admin' ||
             accessLevel == 'internal'
             ? accessLevel
             : ((member.data.get('role', 'member') == 'owner' ||
                 member.data.get('role', 'member') == 'admin')
                ? 'internal'
                : 'planner');
    }

    function memberWorkspaceOverride(teamId, feature) {
      return get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid))
             .data
             .get('workspaceOverrides', {})
             .get(feature, null);
    }

    function workspaceAllowedByProfile(accessLevel, feature) {
      return accessLevel == 'internal' ||
             (accessLevel == 'admin' &&
              (feature in [
                'workspaceFixedRoute',
                'workspaceOperations',
                'workspaceOndemand',
                'analyticsTransitApp',
                'analyticsOdMatrix',
                'analyticsStudentPass',
                'analyticsFleetPlan',
                'analyticsResidentialGrowth',
                'analyticsRoutePlanner2',
                'operationsLoadProfiles',
                'operationsOperatorDwell'
              ])) ||
             (accessLevel == 'planner' &&
              (feature in [
                'workspaceFixedRoute',
                'workspaceOperations',
                'workspaceOndemand',
                'analyticsTransitApp',
                'analyticsStudentPass',
                'analyticsFleetPlan',
                'analyticsResidentialGrowth',
                'analyticsRoutePlanner2'
              ])) ||
             (accessLevel == 'production' &&
              (feature in ['workspaceFixedRoute', 'workspaceOperations'])) ||
             (accessLevel == 'external-planner' &&
              feature == 'analyticsTransitApp') ||
             (accessLevel == 'transit-app-only' &&
              feature == 'analyticsTransitApp');
    }

    function canAccessWorkspace(teamId, feature) {
      return isWorkspacePermissionManager() ||
             (isTeamMember(teamId) &&
              (memberWorkspaceOverride(teamId, feature) == true ||
               (memberWorkspaceOverride(teamId, feature) != false &&
                workspaceAllowedByProfile(memberAccessLevel(teamId), feature))));
    }

    function isWorkspacePermissionManager() {
      return request.auth != null &&
             (request.auth.token.get('schedulerAdmin', false) == true ||
              request.auth.token.get('admin', false) == true ||
              request.auth.token.get('globalAdmin', false) == true);
    }
  }
}
