rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========== USERS ==========

    // Users can access their own document; scheduler admins can read user profiles
    // to identify upload owners without changing user-owned data.
    match /users/{userId} {
      allow get: if request.auth != null &&
                  (request.auth.uid == userId || isSchedulerAdmin());
      allow create, update: if request.auth != null &&
                              request.auth.uid == userId &&
                              isValidActiveTeamSelection(userId);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Uploaded file metadata is user-owned, but scheduler admins can read it for
    // cross-team developer support and troubleshooting.
    match /users/{userId}/files/{fileId} {
      allow read: if request.auth != null &&
                    (request.auth.uid == userId || isSchedulerAdmin());
      allow create: if request.auth != null &&
                      request.auth.uid == userId &&
                      isValidUploadedFileCreate(userId);
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow update: if false;
    }

    // Collection-group support for scheduler-admin File Manager "All uploads".
    match /{path=**}/files/{fileId} {
      allow read: if isSchedulerAdmin();
    }

    // Explicit personal-data collections keep File Manager metadata from
    // inheriting a broader recursive owner-write rule.
    match /users/{userId}/schedules/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/scheduleDrafts/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/draftSchedules/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/systemDrafts/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/newScheduleProjects/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/shuttleProjects/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ========== TEAMS ==========

    // Collection-group membership enumeration is limited to the caller's own
    // records. Client queries must include where('userId', '==', auth.uid).
    match /{path=**}/members/{memberId} {
      allow list: if request.auth != null &&
                    resource.data.userId == request.auth.uid;
    }

    // A scheduler admin may activate one short-lived, team-scoped support
    // session for themselves. The document ID is always the admin's auth UID.
    match /developerSupportSessions/{adminUid} {
      allow get: if isSchedulerAdmin() && request.auth.uid == adminUid;
      allow create, update, delete: if false;
      allow list: if false;
    }

    // Callable-managed immutable audit entries. Scheduler admins may inspect
    // the log, but client SDKs cannot add, change, or remove audit events.
    match /developerSupportAudit/{auditId} {
      allow get, list: if isSchedulerAdmin();
      allow create, update, delete: if false;
    }

    // Team documents are readable by team members.
    // Global workspace permission managers can also look up teams
    // by code for user permission management.
    // Team creation remains authenticated; updates/deletes are available to
    // team owners/admins and workspace permission managers.
    match /teams/{teamId} {
      allow get: if isTeamMember(teamId) || isWorkspacePermissionManager() || canReadTeamForInviteJoin(teamId);
      allow list: if isWorkspacePermissionManager();
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
                      ((isTeamOwnerOrAdmin(teamId) &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['dataSourceTeamIds'])) ||
                       canSupportWriteTeamData(teamId));
      allow delete: if request.auth != null &&
                      (isTeamOwnerOrAdmin(teamId) || canSupportWriteTeamData(teamId));

      // Team Members
      match /members/{memberId} {
        // Allow users to read their own membership doc (needed for invite join flow)
        // and full member list only when already in the team.
        allow read: if request.auth != null &&
                       (request.auth.uid == memberId || isTeamMember(teamId) || isWorkspacePermissionManager());
        // Allow member creation through a valid invite, initial owner creation
        // for a new team, or owner/admin management.
        allow create: if request.auth != null &&
                         (canCreateSelfFromInvite(teamId, memberId) ||
                          canCreateInitialOwner(teamId, memberId) ||
                          isTeamOwnerOrAdmin(teamId) ||
                          canSupportWriteTeamData(teamId));
        allow update: if isTeamOwnerOrAdmin(teamId) ||
                         (canSupportWriteTeamData(teamId) &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accessLevel', 'workspaceOverrides']));
        allow delete: if isTeamOwnerOrAdmin(teamId) || canSupportWriteTeamData(teamId);
      }

      // Master Schedules
      match /masterSchedules/{scheduleId} {
        allow read: if canAccessWorkspace(teamId, 'workspaceFixedRoute') ||
                       canReadSharedMasterSchedules(teamId) ||
                       canSupportReadTeamData(teamId);
        allow create, update, delete: if isTeamOwnerOrAdmin(teamId) || canSupportWriteTeamData(teamId);

        // Version History
        match /versions/{versionId} {
          allow read: if canAccessWorkspace(teamId, 'workspaceFixedRoute') ||
                         canReadSharedMasterSchedules(teamId) ||
                         canSupportReadTeamData(teamId);
          allow create, update, delete: if isTeamOwnerOrAdmin(teamId) || canSupportWriteTeamData(teamId);
        }
      }

      // Team-visible fixed-route schedule review snapshots. Schedule content
      // remains immutable in Storage; this document is bounded metadata only.
      match /scheduleReviews/{reviewId} {
        allow read: if canAccessWorkspace(teamId, 'workspaceFixedRoute') ||
                       canSupportReadTeamData(teamId);
        allow create: if (canAccessWorkspace(teamId, 'workspaceFixedRoute') ||
                          canSupportWriteTeamData(teamId)) &&
                         isValidScheduleReviewCreate(teamId, reviewId);
        allow update: if (isTeamOwnerOrAdmin(teamId) || canSupportWriteTeamData(teamId)) &&
                         isValidScheduleReviewStatusUpdate();
        allow delete: if canSupportWriteTeamData(teamId);
      }

      // Team-authored detour notices and their map/publication records.
      match /detourNotices/{noticeId} {
        allow read: if canAccessWorkspace(teamId, 'workspaceFixedRoute') || canSupportReadTeamData(teamId);
        allow create: if (canAccessWorkspace(teamId, 'workspaceFixedRoute') || canSupportWriteTeamData(teamId)) &&
                         isValidDetourNoticeCreate(teamId);
        allow update: if (canAccessWorkspace(teamId, 'workspaceFixedRoute') || canSupportWriteTeamData(teamId)) &&
                         isValidDetourNoticeUpdate(teamId);
        allow delete: if canAccessWorkspace(teamId, 'workspaceFixedRoute') || canSupportWriteTeamData(teamId);

        match /overlays/{overlayId} {
          allow read: if canAccessWorkspace(teamId, 'workspaceFixedRoute') || canSupportReadTeamData(teamId);
          allow create, update, delete: if canAccessWorkspace(teamId, 'workspaceFixedRoute') || canSupportWriteTeamData(teamId);
        }

        match /publications/{publicationId} {
          allow read: if canAccessWorkspace(teamId, 'workspaceFixedRoute') || canSupportReadTeamData(teamId);
          allow create: if (canAccessWorkspace(teamId, 'workspaceFixedRoute') || canSupportWriteTeamData(teamId)) &&
                           isValidDetourPublicationCreate(teamId, noticeId);
          allow update: if false;
          allow delete: if canAccessWorkspace(teamId, 'workspaceFixedRoute') || canSupportWriteTeamData(teamId);
        }
      }

      // Platform configuration
      match /platformConfig/{configId} {
        allow read: if isTeamMember(teamId) || canSupportReadTeamData(teamId);
        allow create, update, delete: if isTeamOwnerOrAdmin(teamId) || canSupportWriteTeamData(teamId);
      }

      // Passenger-load capacity policy used by Operations aggregation.
      match /performanceConfig/{configId} {
        allow read: if isTeamMember(teamId) || canSupportReadTeamData(teamId);
        allow create: if (isTeamOwnerOrAdmin(teamId) || canSupportWriteTeamData(teamId)) &&
                         configId == 'load' &&
                         isValidPerformanceLoadConfig(request.resource.data) &&
                         request.resource.data.version == 1;
        allow update: if (isTeamOwnerOrAdmin(teamId) || canSupportWriteTeamData(teamId)) &&
                         configId == 'load' &&
                         isValidPerformanceLoadConfig(request.resource.data) &&
                         request.resource.data.version == resource.data.version + 1;
        allow delete: if isTeamOwnerOrAdmin(teamId) || canSupportWriteTeamData(teamId);
      }

      // Shared connection library
      match /connectionLibrary/{libraryId} {
        allow read: if isTeamMember(teamId) || canSupportReadTeamData(teamId);
        allow write: if isTeamMember(teamId) || canSupportWriteTeamData(teamId);
      }

      // Public timetable brochure settings
      match /publicTimetable/{docId} {
        allow read: if isTeamMember(teamId) || canSupportReadTeamData(teamId);
        allow create, update, delete: if isTeamOwnerOrAdmin(teamId) || canSupportWriteTeamData(teamId);
      }

      // Per-route connection configuration
      match /routeConnectionConfigs/{routeIdentity} {
        allow read: if isTeamMember(teamId) || canSupportReadTeamData(teamId);
        allow write: if isTeamMember(teamId) || canSupportWriteTeamData(teamId);
      }

      // Transit App Data
      match /transitAppData/{docId} {
        allow read: if canAccessWorkspace(teamId, 'analyticsTransitApp') || canSupportReadTeamData(teamId);
        allow write: if canAccessWorkspace(teamId, 'analyticsTransitApp') || canSupportWriteTeamData(teamId);
      }

      // Performance Data
      match /performanceData/{docId} {
        allow read: if isTeamMember(teamId) || canSupportReadTeamData(teamId);
        allow write: if isTeamOwnerOrAdmin(teamId) || canSupportWriteTeamData(teamId);
      }

      // Transit On Demand pickup map data
      match /todPickupData/{docId} {
        allow read: if isTeamMember(teamId) || canSupportReadTeamData(teamId);
        allow create, update, delete: if isTeamOwnerOrAdmin(teamId) || canSupportWriteTeamData(teamId);
      }

      // Shared department parking code usage
      match /parking/{docId} {
        allow read: if canAccessWorkspace(teamId, 'workspaceParking') || canSupportReadTeamData(teamId);
        allow create, update, delete: if canAccessWorkspace(teamId, 'workspaceParking') || canSupportWriteTeamData(teamId);

        match /months/{monthId} {
          allow read: if canAccessWorkspace(teamId, 'workspaceParking') || canSupportReadTeamData(teamId);
          allow create, update, delete: if canAccessWorkspace(teamId, 'workspaceParking') || canSupportWriteTeamData(teamId);
        }
      }

      // Monthly performance snapshots
      match /performanceSnapshots/{docId} {
        allow read: if isTeamMember(teamId) || canSupportReadTeamData(teamId);
        allow write: if isTeamMember(teamId) || canSupportWriteTeamData(teamId);
      }

      // OD Matrix Data
      match /odMatrixData/{docId} {
        allow read: if canAccessWorkspace(teamId, 'analyticsOdMatrix') || canSupportReadTeamData(teamId);
        allow write: if canAccessWorkspace(teamId, 'analyticsOdMatrix') || canSupportWriteTeamData(teamId);

        // Import history subcollection
        match /imports/{importId} {
          allow read: if canAccessWorkspace(teamId, 'analyticsOdMatrix') || canSupportReadTeamData(teamId);
          allow write: if canAccessWorkspace(teamId, 'analyticsOdMatrix') || canSupportWriteTeamData(teamId);
        }
      }

      // Fleet Plan data
      match /fleetPlan/{docId} {
        allow read: if canAccessWorkspace(teamId, 'analyticsFleetPlan') || canSupportReadTeamData(teamId);
        allow create, update, delete: if isTeamOwnerOrAdmin(teamId) || canSupportWriteTeamData(teamId);

        // Fleet Plan version history
        match /versions/{versionId} {
          allow read: if canAccessWorkspace(teamId, 'analyticsFleetPlan') || canSupportReadTeamData(teamId);
          allow create, update, delete: if isTeamOwnerOrAdmin(teamId) || canSupportWriteTeamData(teamId);
        }
      }

      // Residential Growth planning data
      match /residentialGrowth/{docId} {
        allow read: if canAccessWorkspace(teamId, 'analyticsResidentialGrowth') || canSupportReadTeamData(teamId);
        allow write: if canAccessWorkspace(teamId, 'analyticsResidentialGrowth') || canSupportWriteTeamData(teamId);

        // Import history subcollection
        match /imports/{importId} {
          allow read: if canAccessWorkspace(teamId, 'analyticsResidentialGrowth') || canSupportReadTeamData(teamId);
          allow write: if canAccessWorkspace(teamId, 'analyticsResidentialGrowth') || canSupportWriteTeamData(teamId);
        }
      }

      // Route Planner 2 saved route concepts
      match /routePlanner2Projects/{projectId} {
        allow read: if canAccessWorkspace(teamId, 'analyticsRoutePlanner2') || canSupportReadTeamData(teamId);
        allow write: if canAccessWorkspace(teamId, 'analyticsRoutePlanner2') || canSupportWriteTeamData(teamId);

        // Editable scenarios saved under each route planner project
        match /scenarios/{scenarioId} {
          allow read: if canAccessWorkspace(teamId, 'analyticsRoutePlanner2') || canSupportReadTeamData(teamId);
          allow write: if canAccessWorkspace(teamId, 'analyticsRoutePlanner2') || canSupportWriteTeamData(teamId);

          // Bounded planner decisions for Mapbox runtime refreshes.
          match /runtimeSnapshots/{snapshotId} {
            allow read: if canAccessWorkspace(teamId, 'analyticsRoutePlanner2') || canSupportReadTeamData(teamId);
            allow write: if canAccessWorkspace(teamId, 'analyticsRoutePlanner2') || canSupportWriteTeamData(teamId);
          }
        }
      }

      // Council and committee meeting intelligence root document.
      match /councilIntelligence/{docId} {
        allow read: if canAccessWorkspace(teamId, 'analyticsCouncilIntelligence') || canSupportReadTeamData(teamId);
        allow write: if isTeamOwnerOrAdmin(teamId) || canSupportWriteTeamData(teamId);

        // Meetings, councillors, registers, and their nested evidence.
        match /{nestedDoc=**} {
          allow read: if canAccessWorkspace(teamId, 'analyticsCouncilIntelligence') || canSupportReadTeamData(teamId);
          allow write: if isTeamOwnerOrAdmin(teamId) || canSupportWriteTeamData(teamId);
        }
      }

      // Route Concept Planner projects are isolated from the working Camp Route Planner.
      // Every nested write is coupled to the revision-checked project root so a stale
      // client cannot silently overwrite newer team work.
      match /routeConceptPlannerProjects/{projectId} {
        allow read: if canAccessWorkspace(teamId, 'analyticsRouteConceptPlanner') || canSupportReadTeamData(teamId);
        allow create: if (canAccessWorkspace(teamId, 'analyticsRouteConceptPlanner') || canSupportWriteTeamData(teamId)) &&
                         isValidRouteConceptProjectCreate(teamId, projectId);
        allow update: if (canAccessWorkspace(teamId, 'analyticsRouteConceptPlanner') || canSupportWriteTeamData(teamId)) &&
                         isValidRouteConceptProjectUpdate(teamId, projectId);
        // Project deletion is not a shipped workflow. Deny it so stale or custom
        // clients cannot bypass revision protection or orphan subcollections.
        allow delete: if false;

        match /alternatives/{alternativeId} {
          allow read: if canAccessWorkspace(teamId, 'analyticsRouteConceptPlanner') || canSupportReadTeamData(teamId);
          allow create, update: if (canAccessWorkspace(teamId, 'analyticsRouteConceptPlanner') || canSupportWriteTeamData(teamId)) &&
                                  isValidRouteConceptAlternativeWrite(teamId, projectId, alternativeId);
          allow delete: if (canAccessWorkspace(teamId, 'analyticsRouteConceptPlanner') || canSupportWriteTeamData(teamId)) &&
                           isRouteConceptChildDeleteCoupled(teamId, projectId);

          match /patterns/{patternId} {
            allow read: if canAccessWorkspace(teamId, 'analyticsRouteConceptPlanner') || canSupportReadTeamData(teamId);
            allow create, update: if (canAccessWorkspace(teamId, 'analyticsRouteConceptPlanner') || canSupportWriteTeamData(teamId)) &&
                                    isValidRouteConceptPatternWrite(teamId, projectId, alternativeId, patternId);
            allow delete: if (canAccessWorkspace(teamId, 'analyticsRouteConceptPlanner') || canSupportWriteTeamData(teamId)) &&
                             isRouteConceptChildDeleteCoupled(teamId, projectId);
          }
        }
      }

      // Future team-scoped collections inherit support-session access without
      // granting a permanent global bypass. Existing ordinary-user rules above
      // remain authoritative for members and shared sources.
      match /{teamDocument=**} {
        allow read: if canSupportReadTeamData(teamId);
        allow write: if canSupportWriteTeamData(teamId);
      }
    }

    // Invite lookup documents support the authenticated join flow.
    match /teamInvites/{inviteCode} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
                              request.resource.data.teamId is string &&
                              (isTeamOwnerOrAdmin(request.resource.data.teamId) ||
                               canSupportWriteTeamData(request.resource.data.teamId) ||
                               canCreateInviteForNewTeam(request.resource.data.teamId));
      allow delete: if request.auth != null &&
                       resource.data.teamId is string &&
                       (isTeamOwnerOrAdmin(resource.data.teamId) || canSupportWriteTeamData(resource.data.teamId));
    }

    // ========== HELPER FUNCTIONS ==========

    function isTeamMember(teamId) {
      return request.auth != null &&
             exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    function isValidActiveTeamSelection(userId) {
      let teamId = request.resource.data.get('teamId', null);
      return teamId == null ||
             (teamId is string &&
              existsAfter(/databases/$(database)/documents/teams/$(teamId)) &&
              existsAfter(/databases/$(database)/documents/teams/$(teamId)/members/$(userId)));
    }

    function hasUserTeam() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamId is string;
    }

    function userTeamId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamId;
    }

    function teamDataSources(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)).data.get('dataSourceTeamIds', {});
    }

    function configuredMasterScheduleSource(teamId) {
      return teamDataSources(teamId).get(
        'masterSchedules',
        teamDataSources(teamId).get('performance', '')
      );
    }

    function canReadSharedMasterSchedules(sourceTeamId) {
      return hasUserTeam() &&
             userTeamId() != sourceTeamId &&
             isTeamMember(userTeamId()) &&
             canAccessWorkspace(userTeamId(), 'workspaceFixedRoute') &&
             configuredMasterScheduleSource(userTeamId()) == sourceTeamId;
    }

    function canReadTeamForInviteJoin(teamId) {
      let inviteCode = resource.data.inviteCode;
      return request.auth != null &&
             inviteCode is string &&
             exists(/databases/$(database)/documents/teamInvites/$(inviteCode)) &&
             get(/databases/$(database)/documents/teamInvites/$(inviteCode)).data.teamId == teamId;
    }

    function canCreateSelfFromInvite(teamId, memberId) {
      let inviteCode = request.resource.data.inviteCode;
      return request.auth.uid == memberId &&
             request.resource.data.role == 'member' &&
             inviteCode is string &&
             exists(/databases/$(database)/documents/teamInvites/$(inviteCode)) &&
             get(/databases/$(database)/documents/teamInvites/$(inviteCode)).data.teamId == teamId;
    }

    function canCreateInitialOwner(teamId, memberId) {
      return request.auth.uid == memberId &&
             request.resource.data.role == 'owner' &&
             !exists(/databases/$(database)/documents/teams/$(teamId)) &&
             getAfter(/databases/$(database)/documents/teams/$(teamId)).data.createdBy == request.auth.uid;
    }

    function canCreateInviteForNewTeam(teamId) {
      return !exists(/databases/$(database)/documents/teams/$(teamId)) &&
             getAfter(/databases/$(database)/documents/teams/$(teamId)).data.createdBy == request.auth.uid &&
             getAfter(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'owner';
    }

    function isTeamOwnerOrAdmin(teamId) {
      let member = get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
      return request.auth != null &&
             (member.data.role == 'owner' || member.data.role == 'admin');
    }

    function isValidPerformanceLoadConfig(data) {
      return data is map &&
             data.keys().hasAll([
               'schemaVersion', 'defaultCapacity', 'vehicleCapacities',
               'version', 'updatedAt', 'updatedBy'
             ]) &&
             data.keys().hasOnly([
               'schemaVersion', 'defaultCapacity', 'vehicleCapacities',
               'version', 'updatedAt', 'updatedBy'
             ]) &&
             data.schemaVersion == 1 &&
             data.defaultCapacity is int &&
             data.defaultCapacity >= 20 && data.defaultCapacity <= 150 &&
             data.vehicleCapacities is map && data.vehicleCapacities.size() <= 500 &&
             data.version is int && data.version > 0 &&
             data.updatedAt == request.time &&
             data.updatedBy == request.auth.uid;
    }

    function isValidScheduleReviewSummary(summary) {
      return summary is map &&
             summary.keys().hasOnly([
               'totalTrips', 'northTrips', 'southTrips',
               'addedTrips', 'removedTrips', 'retimedTrips',
               'extendedTrips', 'shortenedTrips', 'reviewNeededTrips',
               'overlapTrips', 'tightRecoveryTrips', 'warningCount',
               'blockingIssueCount', 'totalChanges'
             ]) &&
             summary.keys().hasAll([
               'totalTrips', 'northTrips', 'southTrips',
               'addedTrips', 'removedTrips', 'retimedTrips',
               'extendedTrips', 'shortenedTrips', 'reviewNeededTrips',
               'overlapTrips', 'tightRecoveryTrips', 'warningCount',
               'blockingIssueCount', 'totalChanges'
             ]) &&
             summary.totalTrips is int && summary.totalTrips >= 0 && summary.totalTrips <= 10000 &&
             summary.northTrips is int && summary.northTrips >= 0 &&
             summary.southTrips is int && summary.southTrips >= 0 &&
             summary.totalTrips == summary.northTrips + summary.southTrips &&
             summary.addedTrips is int && summary.addedTrips >= 0 &&
             summary.removedTrips is int && summary.removedTrips >= 0 &&
             summary.retimedTrips is int && summary.retimedTrips >= 0 &&
             summary.extendedTrips is int && summary.extendedTrips >= 0 &&
             summary.shortenedTrips is int && summary.shortenedTrips >= 0 &&
             summary.reviewNeededTrips is int && summary.reviewNeededTrips >= 0 &&
             summary.overlapTrips is int && summary.overlapTrips >= 0 &&
             summary.tightRecoveryTrips is int && summary.tightRecoveryTrips >= 0 &&
             summary.warningCount is int && summary.warningCount >= 0 && summary.warningCount <= 10000 &&
             summary.blockingIssueCount is int && summary.blockingIssueCount >= 0 && summary.blockingIssueCount <= 10000 &&
             summary.totalChanges is int &&
             summary.totalChanges == summary.addedTrips + summary.removedTrips +
                                     summary.retimedTrips + summary.extendedTrips +
                                     summary.shortenedTrips + summary.reviewNeededTrips;
    }

    function isValidScheduleReviewCreate(teamId, reviewId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
               'schemaVersion', 'teamId', 'routeNumber', 'dayType', 'draftId',
               'sourceVersion', 'status', 'plannerNote', 'summary', 'storagePath',
               'payloadBytes', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasAll([
               'schemaVersion', 'teamId', 'routeNumber', 'dayType', 'draftId',
               'sourceVersion', 'status', 'plannerNote', 'summary', 'storagePath',
               'payloadBytes', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'
             ]) &&
             data.schemaVersion == 1 &&
             data.teamId == teamId &&
             data.routeNumber is string && data.routeNumber.size() > 0 && data.routeNumber.size() <= 16 &&
             data.dayType in ['Weekday', 'Saturday', 'Sunday'] &&
             data.draftId is string && data.draftId.size() > 0 && data.draftId.size() <= 128 &&
             data.sourceVersion is int && data.sourceVersion >= 0 && data.sourceVersion <= 1000000 &&
             data.status == 'ready_for_review' &&
             data.plannerNote is string && data.plannerNote.size() <= 2000 &&
             isValidScheduleReviewSummary(data.summary) &&
             data.payloadBytes is int && data.payloadBytes > 0 && data.payloadBytes <= 10 * 1024 * 1024 &&
             data.createdBy == request.auth.uid &&
             data.createdByName is string && data.createdByName.size() > 0 && data.createdByName.size() <= 200 &&
             data.storagePath == 'teams/' + teamId + '/scheduleReviews/' + reviewId + '/' + request.auth.uid + '/schedule.json' &&
             data.createdAt is timestamp && data.createdAt == request.time &&
             data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidScheduleReviewStatusUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status', 'reviewedBy', 'reviewedAt', 'updatedAt'
             ]) &&
             request.resource.data.status in ['ready_for_review', 'approved', 'changes_requested'] &&
             request.resource.data.reviewedBy == request.auth.uid &&
             request.resource.data.reviewedAt is timestamp && request.resource.data.reviewedAt == request.time &&
             request.resource.data.updatedAt is timestamp && request.resource.data.updatedAt == request.time;
    }

    function memberAccessLevel(teamId) {
      let member = get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
      let accessLevel = member.data.get('accessLevel', null);
      return accessLevel == 'none' ||
             accessLevel == 'production' ||
             accessLevel == 'planner' ||
             accessLevel == 'external-planner' ||
             accessLevel == 'transit-app-only' ||
             accessLevel == 'parking' ||
             accessLevel == 'admin' ||
             accessLevel == 'internal'
             ? accessLevel
             : ((member.data.get('role', 'member') == 'owner' ||
                 member.data.get('role', 'member') == 'admin')
                ? 'internal'
                : 'planner');
    }

    function memberWorkspaceOverride(teamId, feature) {
      return get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid))
             .data
             .get('workspaceOverrides', {})
             .get(feature, null);
    }

    function workspaceAllowedByProfile(accessLevel, feature) {
      return accessLevel == 'internal' ||
             (accessLevel == 'admin' &&
              (feature in [
                'workspaceFixedRoute',
                'workspaceOperations',
                'workspaceParking',
                'workspaceOndemand',
                'analyticsTransitApp',
                'analyticsOdMatrix',
                'analyticsStudentPass',
                'analyticsFleetPlan',
                'analyticsResidentialGrowth',
                'analyticsRoutePlanner2',
                'analyticsCouncilIntelligence',
                'operationsLoadProfiles',
                'operationsOperatorDwell'
              ])) ||
             (accessLevel == 'planner' &&
              (feature in [
                'workspaceFixedRoute',
                'workspaceOperations',
                'workspaceOndemand',
                'analyticsTransitApp',
                'analyticsStudentPass',
                'analyticsFleetPlan',
                'analyticsResidentialGrowth',
                'analyticsRoutePlanner2',
                'analyticsCouncilIntelligence'
              ])) ||
             (accessLevel == 'production' &&
              (feature in ['workspaceFixedRoute', 'workspaceOperations'])) ||
             (accessLevel == 'external-planner' &&
              feature == 'analyticsTransitApp') ||
             (accessLevel == 'transit-app-only' &&
              feature == 'analyticsTransitApp') ||
             (accessLevel == 'parking' &&
              feature == 'workspaceParking');
    }

    function isValidRouteConceptProjectCreate(teamId, projectId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
               'id', 'teamId', 'schemaVersion', 'revision', 'name', 'status',
               'selectedAlternativeId', 'preferredAlternativeId',
               'alternativeOrder', 'alternativeCount',
               'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
             ]) &&
             data.keys().hasAll([
               'id', 'teamId', 'schemaVersion', 'revision', 'name', 'status',
               'selectedAlternativeId', 'alternativeOrder', 'alternativeCount',
               'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
             ]) &&
             data.id == projectId && data.teamId == teamId &&
             data.schemaVersion == 1 && data.revision == 1 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.status in ['local-saved', 'archived'] &&
             data.selectedAlternativeId is string && data.selectedAlternativeId.size() <= 128 &&
             (!data.keys().hasAny(['preferredAlternativeId']) ||
               (data.preferredAlternativeId is string && data.preferredAlternativeId.size() <= 128)) &&
             data.alternativeOrder is list && data.alternativeOrder.size() <= 50 &&
             data.alternativeCount is int && data.alternativeCount == data.alternativeOrder.size() &&
             data.createdAt is timestamp && data.createdAt == request.time &&
             data.updatedAt is timestamp && data.updatedAt == request.time &&
             data.createdBy == request.auth.uid && data.updatedBy == request.auth.uid;
    }

    function isValidRouteConceptProjectUpdate(teamId, projectId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
               'id', 'teamId', 'schemaVersion', 'revision', 'name', 'status',
               'selectedAlternativeId', 'preferredAlternativeId',
               'alternativeOrder', 'alternativeCount',
               'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
             ]) &&
             data.keys().hasAll([
               'id', 'teamId', 'schemaVersion', 'revision', 'name', 'status',
               'selectedAlternativeId', 'alternativeOrder', 'alternativeCount',
               'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
             ]) &&
             data.id == projectId && data.teamId == teamId &&
             data.schemaVersion == 1 && resource.data.schemaVersion == 1 &&
             data.revision is int && data.revision == resource.data.revision + 1 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.status in ['local-saved', 'archived'] &&
             data.selectedAlternativeId is string && data.selectedAlternativeId.size() <= 128 &&
             (!data.keys().hasAny(['preferredAlternativeId']) ||
               (data.preferredAlternativeId is string && data.preferredAlternativeId.size() <= 128)) &&
             data.alternativeOrder is list && data.alternativeOrder.size() <= 50 &&
             data.alternativeCount is int && data.alternativeCount == data.alternativeOrder.size() &&
             data.createdAt == resource.data.createdAt && data.createdBy == resource.data.createdBy &&
             data.updatedAt is timestamp && data.updatedAt == request.time &&
             data.updatedBy == request.auth.uid;
    }

    function routeConceptRootAfter(teamId, projectId) {
      return getAfter(/databases/$(database)/documents/teams/$(teamId)/routeConceptPlannerProjects/$(projectId));
    }

    function isValidRouteConceptAlternativeWrite(teamId, projectId, alternativeId) {
      let data = request.resource.data;
      let root = routeConceptRootAfter(teamId, projectId);
      return existsAfter(/databases/$(database)/documents/teams/$(teamId)/routeConceptPlannerProjects/$(projectId)) &&
             root.data.updatedBy == request.auth.uid && root.data.updatedAt == request.time &&
             alternativeId in root.data.alternativeOrder &&
             data.keys().hasOnly(['id', 'teamId', 'projectId', 'schemaVersion', 'payload', 'updatedAt', 'updatedBy']) &&
             data.keys().hasAll(['id', 'teamId', 'projectId', 'schemaVersion', 'payload', 'updatedAt', 'updatedBy']) &&
             data.id == alternativeId && data.teamId == teamId && data.projectId == projectId &&
             data.schemaVersion == 1 && isValidRouteConceptAlternativePayload(data.payload, alternativeId) &&
             data.updatedAt is timestamp && data.updatedAt == request.time && data.updatedBy == request.auth.uid;
    }

    function isValidRouteConceptPatternWrite(teamId, projectId, alternativeId, patternId) {
      let data = request.resource.data;
      let root = routeConceptRootAfter(teamId, projectId);
      let alternativePath = /databases/$(database)/documents/teams/$(teamId)/routeConceptPlannerProjects/$(projectId)/alternatives/$(alternativeId);
      let alternative = getAfter(alternativePath);
      return existsAfter(/databases/$(database)/documents/teams/$(teamId)/routeConceptPlannerProjects/$(projectId)) &&
             existsAfter(alternativePath) &&
             root.data.updatedBy == request.auth.uid && root.data.updatedAt == request.time &&
             alternativeId in root.data.alternativeOrder &&
             patternId in alternative.data.payload.patternOrder &&
             data.keys().hasOnly(['id', 'teamId', 'projectId', 'alternativeId', 'schemaVersion', 'payload', 'updatedAt', 'updatedBy']) &&
             data.keys().hasAll(['id', 'teamId', 'projectId', 'alternativeId', 'schemaVersion', 'payload', 'updatedAt', 'updatedBy']) &&
             data.id == patternId && data.teamId == teamId && data.projectId == projectId && data.alternativeId == alternativeId &&
             data.schemaVersion == 1 && isValidRouteConceptPatternPayload(data.payload, patternId) &&
             data.updatedAt is timestamp && data.updatedAt == request.time && data.updatedBy == request.auth.uid;
    }

    function isValidRouteConceptAlternativePayload(payload, alternativeId) {
      return payload is map &&
             payload.keys().hasOnly([
               'id', 'name', 'status', 'structure', 'patternOrder', 'service',
               'notes', 'createdAt', 'updatedAt'
             ]) &&
             payload.keys().hasAll([
               'id', 'name', 'status', 'structure', 'patternOrder', 'service',
               'notes', 'createdAt', 'updatedAt'
             ]) &&
             payload.id == alternativeId && payload.patternOrder is list;
    }

    function isValidRouteConceptPatternPayload(payload, patternId) {
      return payload is map &&
             payload.keys().hasOnly([
               'id', 'name', 'role', 'alignment', 'stops', 'segmentFingerprints',
               'runtimeEvidence', 'runtimeOverrides', 'source', 'notes',
               'createdAt', 'updatedAt'
             ]) &&
             payload.keys().hasAll([
               'id', 'name', 'role', 'alignment', 'stops', 'runtimeEvidence',
               'runtimeOverrides', 'notes', 'createdAt', 'updatedAt'
             ]) &&
             payload.id == patternId;
    }

    function isRouteConceptChildDeleteCoupled(teamId, projectId) {
      let rootPath = /databases/$(database)/documents/teams/$(teamId)/routeConceptPlannerProjects/$(projectId);
      return existsAfter(rootPath) && exists(rootPath) &&
              getAfter(rootPath).data.updatedBy == request.auth.uid &&
              getAfter(rootPath).data.updatedAt == request.time &&
              getAfter(rootPath).data.revision == get(rootPath).data.revision + 1;
    }

    function isValidDetourNoticeCreate(teamId) {
      let data = request.resource.data;
      return data.teamId == teamId &&
             data.revision == 1 && data.status == 'draft' &&
             data.createdBy == request.auth.uid && data.updatedBy == request.auth.uid &&
             data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function isValidDetourNoticeUpdate(teamId) {
      let data = request.resource.data;
      let isContentSave = data.revision is int && data.revision == resource.data.revision + 1;
      let isMarkPosted = data.revision == resource.data.revision &&
                         data.status == 'posted' && data.latestPostedRevision == data.revision &&
                         data.diff(resource.data).affectedKeys().hasOnly([
                           'status', 'latestPostedRevision', 'updatedAt', 'updatedBy'
                         ]);
      return data.teamId == teamId && data.teamId == resource.data.teamId &&
             data.createdAt == resource.data.createdAt && data.createdBy == resource.data.createdBy &&
             data.updatedBy == request.auth.uid && data.updatedAt is timestamp &&
             (isContentSave || isMarkPosted);
    }

    function isValidDetourPublicationCreate(teamId, noticeId) {
      let data = request.resource.data;
      let notice = getAfter(/databases/$(database)/documents/teams/$(teamId)/detourNotices/$(noticeId));
      return notice != null && notice.data.status == 'posted' &&
             data.noticeId == noticeId && data.revision == notice.data.revision &&
             data.exportedBy == request.auth.uid && data.postedBy == request.auth.uid &&
             data.exportedAt is timestamp && data.postedAt is timestamp &&
             data.myRideUrl is string && data.myRideUrl.size() <= 2000 &&
             data.myRideUrl.matches('https://(www[.])?myridebarrie[.]ca/.*') &&
             data.filenames is map;
    }

    function canAccessWorkspace(teamId, feature) {
      return isTeamMember(teamId) &&
              (isSchedulerAdmin() ||
               memberWorkspaceOverride(teamId, feature) == true ||
               (memberWorkspaceOverride(teamId, feature) != false &&
                workspaceAllowedByProfile(memberAccessLevel(teamId), feature)));
    }

    function isSchedulerAdmin() {
      return request.auth != null &&
             request.auth.token.get('schedulerAdmin', false) == true;
    }

    function isValidUploadedFileCreate(userId) {
      let data = request.resource.data;
      let hasTeamId = data.keys().hasAny(['teamIdAtUpload']);
      let hasTeamName = data.keys().hasAny(['teamNameAtUpload']);
      let hasUploaderName = data.keys().hasAny(['uploaderDisplayNameAtUpload']);
      let hasUploaderEmail = data.keys().hasAny(['uploaderEmailAtUpload']);
      return data.keys().hasOnly([
               'name', 'type', 'storagePath', 'downloadUrl', 'size', 'uploadedAt',
               'teamIdAtUpload', 'teamNameAtUpload',
               'uploaderDisplayNameAtUpload', 'uploaderEmailAtUpload'
             ]) &&
             data.keys().hasAll(['name', 'type', 'storagePath', 'downloadUrl', 'size', 'uploadedAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 255 &&
             data.type in ['schedule_master', 'rideco', 'barrie_tod', 'other'] &&
             data.storagePath is string &&
             data.storagePath.matches('users/' + userId + '/files/[^/]+') &&
             data.downloadUrl is string &&
             data.downloadUrl.matches('https://firebasestorage.googleapis.com/.*') &&
             data.size is int && data.size > 0 && data.size <= 25 * 1024 * 1024 &&
             data.uploadedAt is timestamp && data.uploadedAt == request.time &&
             hasTeamId == hasTeamName &&
             (!hasTeamId ||
              (data.teamIdAtUpload is string &&
               exists(/databases/$(database)/documents/teams/$(data.teamIdAtUpload)/members/$(userId)) &&
               data.teamNameAtUpload == get(/databases/$(database)/documents/teams/$(data.teamIdAtUpload)).data.name)) &&
             hasUploaderName == hasUploaderEmail &&
             (!hasUploaderEmail ||
              (data.uploaderEmailAtUpload == request.auth.token.get('email', '') &&
               data.uploaderDisplayNameAtUpload == get(/databases/$(database)/documents/users/$(userId)).data.displayName));
    }

    function supportSession() {
      return get(/databases/$(database)/documents/developerSupportSessions/$(request.auth.uid));
    }

    function hasActiveSupportSession(teamId) {
      return isSchedulerAdmin() &&
             exists(/databases/$(database)/documents/developerSupportSessions/$(request.auth.uid)) &&
             supportSession().data.teamId == teamId &&
             supportSession().data.expiresAt is timestamp &&
             supportSession().data.expiresAt > request.time &&
             supportSession().data.mode in ['inspect', 'edit'];
    }

    function canSupportReadTeamData(teamId) {
      return hasActiveSupportSession(teamId);
    }

    function canSupportWriteTeamData(teamId) {
      return hasActiveSupportSession(teamId) && supportSession().data.mode == 'edit';
    }

    function isWorkspacePermissionManager() {
      return isSchedulerAdmin();
    }
  }
}
