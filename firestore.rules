rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========== USERS ==========

    // Users can access their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can access their own subdocuments (projects, drafts, etc.)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ========== TEAMS ==========

    // Team documents are readable by team members.
    // Internal/developer and admin workspace users can also look up teams
    // by code for user permission management.
    // Team creation remains authenticated; updates/deletes are available to
    // team owners and workspace permission managers.
    match /teams/{teamId} {
      allow read: if isTeamMember(teamId) || isWorkspacePermissionManager();
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
                              (isTeamOwner(teamId) || isWorkspacePermissionManager());

      // Team Members
      match /members/{memberId} {
        // Allow users to read their own membership doc (needed for invite join flow)
        // and full member list only when already in the team.
        allow read: if request.auth != null &&
                       (request.auth.uid == memberId || isTeamMember(teamId) || isWorkspacePermissionManager());
        // Allow creating your own member document when joining/creating team
        // OR being an owner/admin to manage others
        allow create: if request.auth != null &&
                         (request.auth.uid == memberId || isTeamOwnerOrAdmin(teamId) || isWorkspacePermissionManager());
        allow update: if isTeamOwnerOrAdmin(teamId) ||
                         (isWorkspacePermissionManager() &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accessLevel']));
        allow delete: if isTeamOwnerOrAdmin(teamId) || isWorkspacePermissionManager();
      }

      // Master Schedules
      match /masterSchedules/{scheduleId} {
        allow read: if isTeamMember(teamId);
        allow create, update, delete: if isTeamOwnerOrAdmin(teamId) || isWorkspacePermissionManager();

        // Version History
        match /versions/{versionId} {
          allow read: if isTeamMember(teamId);
          allow create, update, delete: if isTeamOwnerOrAdmin(teamId) || isWorkspacePermissionManager();
        }
      }

      // Platform configuration
      match /platformConfig/{configId} {
        allow read: if isTeamMember(teamId);
        allow create, update, delete: if isTeamOwnerOrAdmin(teamId) || isWorkspacePermissionManager();
      }

      // Shared connection library
      match /connectionLibrary/{libraryId} {
        allow read, write: if isTeamMember(teamId);
      }

      // Public timetable brochure settings
      match /publicTimetable/{docId} {
        allow read: if isTeamMember(teamId);
        allow create, update, delete: if isTeamOwnerOrAdmin(teamId) || isWorkspacePermissionManager();
      }

      // Per-route connection configuration
      match /routeConnectionConfigs/{routeIdentity} {
        allow read, write: if isTeamMember(teamId);
      }

      // Transit App Data
      match /transitAppData/{docId} {
        allow read, write: if isTeamMember(teamId);
      }

      // Performance Data
      match /performanceData/{docId} {
        allow read, write: if isTeamMember(teamId);
      }

      // Monthly performance snapshots
      match /performanceSnapshots/{docId} {
        allow read, write: if isTeamMember(teamId);
      }

      // OD Matrix Data
      match /odMatrixData/{docId} {
        allow read, write: if isTeamMember(teamId);

        // Import history subcollection
        match /imports/{importId} {
          allow read, write: if isTeamMember(teamId);
        }
      }

      // Fleet Plan data
      match /fleetPlan/{docId} {
        allow read: if isTeamMember(teamId);
        allow create, update, delete: if isTeamOwnerOrAdmin(teamId) || isWorkspacePermissionManager();

        // Fleet Plan version history
        match /versions/{versionId} {
          allow read: if isTeamMember(teamId);
          allow create, update, delete: if isTeamOwnerOrAdmin(teamId) || isWorkspacePermissionManager();
        }
      }
    }

    // Invite lookup documents support the authenticated join flow.
    match /teamInvites/{inviteCode} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
                              request.resource.data.teamId is string &&
                              (isTeamOwnerOrAdmin(request.resource.data.teamId) || isWorkspacePermissionManager());
      allow delete: if request.auth != null &&
                       resource.data.teamId is string &&
                       (isTeamOwnerOrAdmin(resource.data.teamId) || isWorkspacePermissionManager());
    }

    // ========== HELPER FUNCTIONS ==========

    function isTeamMember(teamId) {
      return request.auth != null &&
             exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    function isTeamOwner(teamId) {
      return request.auth != null &&
             get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'owner';
    }

    function isTeamOwnerOrAdmin(teamId) {
      let member = get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
      return request.auth != null &&
             (member.data.role == 'owner' || member.data.role == 'admin');
    }

    function currentUserTeamId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamId;
    }

    function currentUserAccessLevel() {
      let teamId = currentUserTeamId();
      return get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.accessLevel;
    }

    function currentUserTeamRole() {
      let teamId = currentUserTeamId();
      return get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role;
    }

    function currentUserHasMemberDoc() {
      let teamId = currentUserTeamId();
      return exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    function isWorkspacePermissionManager() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             currentUserTeamId() is string &&
             currentUserHasMemberDoc() &&
             (currentUserAccessLevel() == 'admin' ||
              currentUserAccessLevel() == 'internal' ||
              currentUserTeamRole() == 'owner' ||
              currentUserTeamRole() == 'admin');
    }
  }
}
